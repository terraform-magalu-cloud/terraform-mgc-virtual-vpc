# Local .terraform directories
**/.terraform/*
.terraform/*
# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log
*.xml
*.iml

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lockfiles in module root (modules should not lock provider versions)
.terraform.lock.hcl

# IDE and OS files
.idea/
.vscode/
*.swp
*~
.DS_Store
